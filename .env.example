# EventCraft Environment Variables

# App
NEXT_PUBLIC_APP_NAME=EventCraft
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/eventcraft"

# Authentication
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# API Keys
EVENTBRITE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
